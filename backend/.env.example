# Singularity backend environment template.
# Copy to `.env` (cp .env.example .env) and fill in the values you need.
# Every variable has a safe default in config.py: missing external services
# degrade gracefully rather than crashing the flow.

# --- Ollama / local Gemma ----------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_TIMEOUT_S=120
OLLAMA_NUM_CTX=4096
# Optional larger window for cognitive NLG only (needs VRAM; 6GB GPU: stay at 4096).
# COGNITIVE_OLLAMA_NUM_CTX=6144
# Max in-flight Ollama requests. CPU-only Gemma: 1–2. GPU Ollama: 8–16 typical.
# This is the hard ceiling for ALL Gemma calls (archetype, cognitive, council, DAG).
OLLAMA_CONCURRENCY=12

# --- Agentic LLM throughput / latency tuning ---------------------------------
# Output-token ceilings for structured calls (lower = faster decoding).
DAG_MAX_TOKENS=640
PERSONA_MAX_TOKENS=256
REPORT_POLISH_MAX_TOKENS=1024
# Max web/evidence items passed to report synthesis and External Intelligence section.
REPORT_EVIDENCE_MAX_ITEMS=12

# --- OpenRouter polishing layer (optional) -----------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-2-27b-it
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
USE_OPENROUTER_POLISH=false
# When Ollama is unreachable/errors, generate() falls back to this free-model
# cascade (Nemotron → Gemma 4 31B → Gemma 4 26B → gpt-oss-20b). Independent of
# USE_OPENROUTER_POLISH. Requires OPENROUTER_API_KEY. json_mode prefers gpt-oss first.
OLLAMA_OPENROUTER_FALLBACK=true
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free
# Cap in-flight fallback calls so a persona fan-out does not burn the free-tier RPM.
OPENROUTER_FALLBACK_CONCURRENCY=3
OLLAMA_CIRCUIT_FAILURES=2
OLLAMA_CIRCUIT_COOLDOWN_S=30

# --- Supabase persistence (optional) -----------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# --- Company intelligence (Gemma-orchestrated yfinance) ----------------------
# The financial agent resolves the query to specific public companies via local
# Gemma, then yfinance supplies qualitative, non-price company data (profile, ESG,
# governance, leadership, ownership, analyst sentiment, news).
COMPANY_INTEL_MAX_COMPANIES=3
COMPANY_INTEL_MAX_ITEMS_PER_COMPANY=4

# --- External search / data APIs ---------------------------------------------
# Google search via Serper (https://serper.dev). Used by GoogleSerperResults.
SERPER_API_KEY=
# Parallel web API (https://parallel.ai). Used by ParallelWebSearchTool,
# ParallelExtractTool, and ChatParallelWeb.
PARALLEL_API_KEY=
PARALLEL_BASE_URL=https://api.parallel.ai
# Default tier for the ChatParallelWeb web-grounded chat model.
PARALLEL_CHAT_MODEL=speed
# GDELT global news/event search (keyless, flag-gated). When true and gdeltdoc
# is installed, recent articles + an article-volume time series join evidence
# routing for news/event tasks. Default false keeps existing behavior unchanged.
GDELT_ENABLED=true
GDELT_LOOKBACK_DAYS=3
GDELT_MAX_ARTICLES=8

# --- LangChain tool layer + native search wrappers (optional, flag-gated) -----
# Route evidence collection through the LangChain tool layer.
LANGCHAIN_ENABLED=true
# Route Serper/DuckDuckGo/Parallel fetchers through the official LangChain
# wrapper classes in tools.search_providers (requires langchain-parallel).
LANGCHAIN_NATIVE_TOOLS=true

# --- Graph-RAG (optional, flag-gated) ----------------------------------------
RAG_ENABLED=false
EMBEDDING_MODEL_ID=BAAI/bge-small-en-v1.5
EMBEDDING_DIMS=384
RAG_TOP_K=5

# --- CrewAI synthesis layer (optional, flag-gated) ---------------------------
CREWAI_ENABLED=false
CREW_MAX_PERSONAS_PER_CLUSTER=3

# --- Hugging Face (Days234 personality engine, optional) ---------------------
HF_TOKEN=
PERSONALITY_REPO_ID=Days234/personality-engine
DISABLE_PERSONALITY_ENGINE=false

# --- App / flow tuning -------------------------------------------------------
APP_SECRET_KEY=dev-secret-change-me-min-32-characters
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_ENABLED=false
# fast | balanced | quality — balanced targets sub-10-minute runs on GPU Ollama.
SINGULARITY_LATENCY_MODE=balanced
# Balanced preset targets 600s (sub-10-minute) with packed naturalize.
FLOW_BUDGET_SECONDS=600
PERSONA_POPULATION=1500
PERSONA_BATCHES=6
PERSONA_ARCHETYPES=36
# Real IPIP-300 baseline (CSV with OCEAN + 30 facet columns). If blank, the engine
# auto-loads IPIP Dataset/IPIP300-SCORES-sample-1500.csv from the repo root.
IPIP_DATA_PATH=
# Parallel LLM fan-out for archetype simulation (when cognitive is off).
MAX_CONCURRENT_AGENTS=12
FORECAST_HORIZON_DAYS=90

# --- Entropy-driven cognitive agents -----------------------------------------
COGNITIVE_AGENTS_ENABLED=true
# Overridden by balanced/fast latency presets (150 / 96); quality mode uses env value.
COGNITIVE_LLM_SAMPLE_SIZE=750
# Must be <= OLLAMA_CONCURRENCY (Ollama client semaphore is the hard cap).
COGNITIVE_LLM_CONCURRENCY=12
COGNITIVE_DELIBERATION_MAX_TOKENS=256
# Optional fixed seed for reproducible entropy (leave blank for time-based).
COGNITIVE_RUN_SEED=

# --- NLP natural-language pipeline -------------------------------------------
NLP_PIPELINE_ENABLED=true
SPACY_MODEL=en_core_web_sm
KEYBERT_MODEL=all-MiniLM-L6-v2
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base
PERSONA_TOP_P_MIN=0.85
PERSONA_TOP_P_MAX=0.98
PERSONA_POLISH_OPENROUTER=false
PERSONA_POLISH_CONCURRENCY=8
BERTopic_MIN_COMMENTS=200
VADER_SENTIMENT_MAX_DELTA=0.4
# Programmatic persona NLG: gemma_naturalize (default) or draft_only (no extra LLM).
PROGRAMMATIC_NLG_MODE=gemma_naturalize
# Short-token naturalize pass for ~1,350 programmatic agents.
PROGRAMMATIC_NLG_MAX_TOKENS=96
# Packed naturalize: briefs per Ollama call (balanced preset uses 6).
NATURALIZE_PACK_SIZE=6
# Smaller ctx for naturalize-only calls — faster decode, more parallel headroom.
NATURALIZE_OLLAMA_NUM_CTX=2048
NATURALIZE_PACK_MAX_TOKENS=320

# --- Social simulation + specialist council + consensus -----------------------
SOCIAL_SIMULATION_ENABLED=true
SOCIAL_SIMULATION_ROUNDS=3
SPECIALIST_COUNCIL_ENABLED=true
COUNCIL_POLISH_OPENROUTER=false
CONSENSUS_ENGINE_ENABLED=true

# --- Performance / latency (optional) -----------------------------------------
# Balanced/fast presets override these unless SINGULARITY_LATENCY_MODE=quality.
DECISION_ENGINE_LLM_ENRICH=false

# --- Master log (global JSONL audit trail at repo logs/master.jsonl) ----------
MASTER_LOG_ENABLED=true
MASTER_LOG_PATH=logs/master.jsonl
MASTER_LOG_HEARTBEAT_S=60


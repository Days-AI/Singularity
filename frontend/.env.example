# Frontend environment (Vite). Copy to .env.local for overrides.

# Base URL of the backend that serves the SSE stream + REST endpoints.
# In dev, Vite proxies /api -> this target (see vite.config.ts).
VITE_BACKEND_URL=http://localhost:8000

# Event source mode:
#   "live"  -> connect to the FastAPI mock/real backend via EventSource (/api/stream/...)
#   "mock"  -> use the in-browser scripted generator (no backend needed)
VITE_STREAM_MODE=live
